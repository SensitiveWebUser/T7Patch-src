// T7Patch.rc VERSIONINFO resource.
//
// A DLL with no version resource is a well-known antivirus heuristic trigger.
//
// Keep these in sync with ZBR_VERSION_FULL in framework.h.

#include <winres.h>

#define T7PATCH_VERSION             3,0,5,0
#define T7PATCH_VERSION_STR         "3.0.5.0"
#define T7PATCH_PRODUCTVERSION_STR  "Patch 3.05"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION        T7PATCH_VERSION
 PRODUCTVERSION     T7PATCH_VERSION
 FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
 FILEFLAGS          0x0L
 FILEOS             VOS_NT_WINDOWS32
 FILETYPE           VFT_DLL
 FILESUBTYPE        VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "T7Patch Community Project"
            VALUE "FileDescription",  "T7Patch - community patch for Call of Duty: Black Ops III"
            VALUE "FileVersion",      T7PATCH_VERSION_STR
            VALUE "InternalName",     "T7Patch"
            VALUE "LegalCopyright",   "Copyright (C) 2026 serious and the T7Patch contributors"
            VALUE "OriginalFilename", "T7Patch.dll"
            VALUE "ProductName",      "T7Patch"
            VALUE "ProductVersion",   T7PATCH_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

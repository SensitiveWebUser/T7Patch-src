{
  "productName": "T7Patch",
  "version": "0.1.0",
  "identifier": "com.t7patch.injector",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "bun run --cwd ../ui build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ../ui dev"
  },
  "app": {
    "windows": [{ "label": "main", "title": "T7Patch", "width": 600, "height": 540, "minWidth": 420, "minHeight": 400, "resizable": true }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
